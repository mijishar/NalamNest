# Copy to .env and fill in. Never commit .env to git.
# AWS credentials — use aws configure or aws sso login instead where possible.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_PROFILE=default

# Override the Bedrock model (default: us.amazon.nova-2-lite-v1:0)
# SHIP_MODEL=us.amazon.nova-2-lite-v1:0

# Test mode for ss measure — auto-confirms write operations using case confirm_response field.
# Never set to 1 in real use.
# NALAMNES_TEST_MODE=0
